`timescale 1ns/1ps

module mux4x1_tb;

reg I0, I1, I2, I3;
reg S1, S0;
wire Y;

mux4x1 uut (
    .I0(I0),
    .I1(I1),
    .I2(I2),
    .I3(I3),
    .S1(S1),
    .S0(S0),
    .Y(Y)
);

initial begin

    // Fixed input values
    I0 = 0;
    I1 = 1;
    I2 = 0;
    I3 = 1;

    $display("S1 S0 | I0 I1 I2 I3 | Y");
    $display("-------------------------");

    S1 = 0; S0 = 0; #10;
    $display("%b  %b  | %b  %b  %b  %b | %b", S1, S0, I0, I1, I2, I3, Y);

    S1 = 0; S0 = 1; #10;
    $display("%b  %b  | %b  %b  %b  %b | %b", S1, S0, I0, I1, I2, I3, Y);

    S1 = 1; S0 = 0; #10;
    $display("%b  %b  | %b  %b  %b  %b | %b", S1, S0, I0, I1, I2, I3, Y);

    S1 = 1; S0 = 1; #10;
    $display("%b  %b  | %b  %b  %b  %b | %b", S1, S0, I0, I1, I2, I3, Y);

    $finish;

end

endmodule